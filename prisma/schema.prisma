// =====================================================================
// ANDALUS CREATIVE WORLD — Prisma Schema (FASE 00)
// PostgreSQL. Solo modelos con necesidad real en Fase 00.
// Modelos futuros (Character, Screenplay, Scene, Shot, MediaAsset,
// RenderJob, PublicProfile, Festival, Submission...) se documentan
// en docs/FASE00_BASE_DATOS.md y NO se crean todavia.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- IDENTIDAD / AUTENTICACION ----------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailLower      String    @unique
  passwordHash    String?
  displayName     String    @default("")
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities     ExternalIdentity[]
  sessions       Session[]
  projects       Project[]
  wallet         CreditWallet?
  securityEvents SecurityEvent[]
  emailTokens    EmailVerificationToken[]
  resetTokens    PasswordResetToken[]

  @@map("users")
}

model ExternalIdentity {
  id              String   @id @default(uuid())
  userId          String
  provider        String
  subject         String
  emailAtProvider String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@map("external_identities")
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  tokenHash     String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  ipHash        String?
  userAgentHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  type      String
  ipHash    String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("security_events")
}

// ---------- PROYECTOS / DOCUMENTOS (Andalus Cinema, Fase 00) ----------

model Project {
  id         String   @id @default(uuid())
  ownerId    String
  name       String
  visibility String   @default("private")
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documents SourceDocument[]

  @@index([ownerId])
  @@map("projects")
}

model SourceDocument {
  id             String   @id @default(uuid())
  projectId      String
  ownerId        String
  filename       String
  storageKey     String   @unique
  mimeType       String
  sizeBytes      BigInt
  checksumSha256 String
  rightsDeclared Boolean  @default(false)
  rightsBasis    String?
  status         String   @default("uploaded")
  pagesCount     Int?
  extractedChars Int?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processingJobs DocumentProcessingJob[]
  pages          DocumentPage[]

  @@index([projectId])
  @@index([ownerId])
  @@map("source_documents")
}

model DocumentPage {
  id         String @id @default(uuid())
  documentId String
  pageNumber Int
  text       String @db.Text
  charCount  Int

  document SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentProcessingJob {
  id         String    @id @default(uuid())
  documentId String
  kind       String
  status     String    @default("queued")
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  document SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_processing_jobs")
}

// ---------- ECONOMIA (contratos; sin cobros reales en Fase 00) ----------

model CreditWallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  purchasedUnits    BigInt   @default(0)
  promoUnits        BigInt   @default(0)
  reservedUnits     BigInt   @default(0)
  consumedUnits     BigInt   @default(0)
  currencyCode      String   @default("EUR_CREDIT")
  conversionVersion String   @default("v1")
  updatedAt         DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries CreditLedgerEntry[]

  @@map("credit_wallets")
}

model CreditLedgerEntry {
  id             BigInt   @id @default(autoincrement())
  walletId       String
  movementType   String
  amountUnits    BigInt
  referenceType  String?
  referenceId    String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@map("credit_ledger_entries")
}

model PromotionCampaign {
  id                       String    @id @default(uuid())
  code                     String    @unique
  name                     String
  eligibleOncePerUser      Boolean   @default(true)
  minPaidAmountMinor       Int       @default(2000)
  currency                 String    @default("EUR")
  grantMultiplierNumerator Int       @default(1)
  grantMultiplierDenominator Int     @default(1)
  active                   Boolean   @default(false)
  startsAt                 DateTime?
  endsAt                   DateTime?
  createdAt                DateTime  @default(now())

  redemptions PromotionRedemption[]

  @@map("promotion_campaigns")
}

model PromotionRedemption {
  id             String   @id @default(uuid())
  campaignId     String
  userId         String
  paidAmountMinor Int
  grantedUnits   BigInt
  paymentRef     String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  campaign PromotionCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, userId])
  @@map("promotion_redemptions")
}

model PaymentRecord {
  id             String    @id @default(uuid())
  userId         String
  provider       String
  mode           String
  externalRef    String?   @unique
  purpose        String
  amountMinor    Int
  currency       String
  status         String
  idempotencyKey String?   @unique
  confirmedAt    DateTime?
  rawEventDigest String?
  createdAt      DateTime  @default(now())

  @@index([userId, status])
  @@map("payment_records")
}
