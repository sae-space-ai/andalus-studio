# Prisma Schema — Andalus Studio
# Este archivo define el modelo de datos completo.
# Requiere PostgreSQL en entorno real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// IDENTIDAD Y ACCESO
// ═══════════════════════════════════════════

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerifiedAt   DateTime?
  passwordHash      String
  displayName       String
  role              String    @default("USER") // USER, STAFF, ADMIN
  status            String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, ACTIVE, SUSPENDED, DISABLED
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  deletedAt         DateTime?

  sessions            Session[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordReset[]
  memberships         Membership[]
  auditEvents         AuditEvent[]
  loginAttempts       LoginAttempt[]
  securityEvents      SecurityEvent[]

  @@index([email])
  @@index([status])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ═══════════════════════════════════════════
// ORGANIZACIÓN Y ROLES
// ═══════════════════════════════════════════

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships   Membership[]
  projects      Project[]
  entitlement   Entitlement?
  subscription  Subscription?
  stripeCustomer StripeCustomer?
  wallet        Wallet?
  auditEvents   AuditEvent[]

  @@index([slug])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ═══════════════════════════════════════════
// CONTENIDO
// ═══════════════════════════════════════════

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  toolRuns     ToolRun[]

  @@index([organizationId])
}

model Asset {
  id             String   @id @default(uuid())
  projectId      String
  organizationId String
  name           String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

enum ToolStatus {
  DRAFT
  DEVELOPMENT
  TESTED
  PUBLISHED
  DISABLED
}

model Tool {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  category    String
  status      ToolStatus @default(DRAFT)
  creditCost  Int        // Coste base en créditos
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  versions ToolVersion[]
  toolRuns ToolRun[]

  @@index([status])
  @@index([category])
}

model ToolVersion {
  id          String   @id @default(uuid())
  toolId      String
  version     String   // semver
  changelog   String?
  config      Json?    // Configuración de la versión
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, version])
  @@index([toolId])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id             String    @id @default(uuid())
  organizationId String
  toolRunId      String?
  status         JobStatus @default(PENDING)
  progress       Int       @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([status])
}

model ToolRun {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String?
  toolId         String
  toolVersionId  String?
  inputs         Json
  outputs        Json?
  creditsUsed    Int      @default(0)
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  tool       Tool       @relation(fields: [toolId], references: [id])
  project    Project?   @relation(fields: [projectId], references: [id])
  artifacts  Artifact[]
  creditHold CreditHold?

  @@index([organizationId])
  @@index([toolId])
}

model Artifact {
  id        String   @id @default(uuid())
  toolRunId String
  type      String   // "audio", "midi", "image", "text", etc.
  name      String
  storageKey String
  sizeBytes Int
  metadata  Json?
  createdAt DateTime @default(now())

  toolRun ToolRun @relation(fields: [toolRunId], references: [id], onDelete: Cascade)

  @@index([toolRunId])
}

// ═══════════════════════════════════════════
// ECONOMÍA Y SISTEMA COMERCIAL (FASE 03)
// ═══════════════════════════════════════════

model Plan {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  name                  String
  description           String?
  priceMonthly          Int      // céntimos de euro
  priceYearly           Int      // céntimos de euro
  currency              String   @default("EUR")
  billingInterval       String   @default("monthly") // monthly, yearly
  includedCredits       Int      // Créditos incluidos por periodo
  creditsRollover       Boolean  @default(false) // Si los créditos no usados acumulan
  maxUsers              Int
  storageBytes          BigInt
  concurrencyLimit      Int      @default(1) // Trabajos simultáneos
  features              Json     // Features habilitadas
  limits                Json?    // Límites específicos
  toolAccess            Json?    // Herramientas accesibles
  stripePriceIdMonthly  String?  // ID de precio mensual en Stripe
  stripePriceIdYearly   String?  // ID de precio anual en Stripe
  status                String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  version               Int      @default(1) // Versión del plan
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organizations  Organization[]
  entitlements   Entitlement[]
  subscriptions  Subscription[]

  @@index([slug])
  @@index([status])
}

model Entitlement {
  id                String    @id @default(uuid())
  organizationId    String    @unique
  planId            String
  status            String    @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED
  creditsTotal      Int       // Créditos totales del periodo
  creditsUsed       Int       @default(0)
  creditsReserved   Int       @default(0) // Créditos reservados en trabajos pendientes
  periodStart       DateTime  // Inicio del periodo actual
  periodEnd         DateTime? // Fin del periodo actual
  activeSince       DateTime  @default(now())
  activeUntil       DateTime?
  features          Json?     // Features específicas habilitadas
  toolAccess        Json?     // Herramientas accesibles
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model Subscription {
  id                      String    @id @default(uuid())
  organizationId          String    @unique
  stripeSubscriptionId    String    @unique
  stripeCustomerId        String?
  planId                  String
  status                  String    // incomplete, trialing, active, past_due, unpaid, canceled, paused
  billingCycleAnchor      DateTime?
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAt                DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  canceledAt              DateTime?
  endedAt                 DateTime?
  trialStart              DateTime?
  trialEnd                DateTime?
  latestInvoiceId         String?
  defaultPaymentMethodId  String?
  metadata                Json?
  lastSyncedAt            DateTime? // Última sincronización con Stripe
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([organizationId])
}

model StripeCustomer {
  id             String @id @default(uuid())
  organizationId String @unique
  stripeCustomerId String @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model StripeEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // Stripe event ID
  type        String
  data        Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model Wallet {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  balance           Int      @default(0) // Créditos disponibles (enteros)
  totalCredits      Int      @default(0) // Total de créditos recibidos
  totalConsumed     Int      @default(0) // Total de créditos consumidos
  totalReserved     Int      @default(0) // Créditos reservados actualmente
  currency          String   @default("CREDITS")
  lastReconciledAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries   CreditLedgerEntry[]
  creditHolds     CreditHold[]
  creditGrants    CreditGrant[]

  @@index([organizationId])
}

model CreditHold {
  id        String   @id @default(uuid())
  walletId  String
  toolRunId String   @unique
  amount    Int
  status    String   @default("held") // held, released, settled
  createdAt DateTime @default(now())
  settledAt DateTime?

  wallet  Wallet  @relation(fields: [walletId], references: [id])
  toolRun ToolRun @relation(fields: [toolRunId], references: [id])

  @@index([walletId])
}

enum LedgerEntryType {
  GRANT        // Créditos concedidos (plan, compra, promoción)
  PURCHASE     // Compra de créditos adicionales
  RESERVE      // Reserva para trabajo pendiente
  CAPTURE      // Consumo confirmado de trabajo
  RELEASE      // Liberación de reserva no utilizada
  REFUND       // Devolución por trabajo fallido
  EXPIRE       // Créditos expirados
  ADJUSTMENT   // Ajuste administrativo
}

model CreditLedgerEntry {
  id                String           @id @default(uuid())
  walletId          String
  entryType         LedgerEntryType
  amount            Int              // Positivo = entrada, negativo = salida
  balanceAfter      Int              // Saldo después de este movimiento
  relatedJobId      String?          // ID del trabajo relacionado
  relatedInvoiceId  String?          // ID de factura relacionada
  relatedSubscriptionId String?      // ID de suscripción relacionada
  idempotencyKey    String?          @unique // Clave de idempotencia
  description       String?
  metadata          Json?
  createdAt         DateTime         @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([relatedJobId])
  @@index([relatedInvoiceId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model UsageEvent {
  id             String   @id @default(uuid())
  organizationId String
  toolId         String
  toolRunId      String?
  creditsUsed    Int
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([toolId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// CONCESIONES DE CRÉDITOS (FASE 03)
// ═══════════════════════════════════════════

model CreditGrant {
  id                String   @id @default(uuid())
  walletId          String
  grantType         String   // SUBSCRIPTION, PURCHASE, PROMOTION, ADJUSTMENT
  amount            Int      // Cantidad de créditos concedidos
  source            String?  // Fuente: "plan_creator", "pack_medium", etc.
  relatedInvoiceId  String?
  relatedSubscriptionId String?
  expiresAt         DateTime? // Cuándo expiran estos créditos
  consumedAt        DateTime? // Cuándo se consumieron completamente
  status            String   @default("ACTIVE") // ACTIVE, CONSUMED, EXPIRED
  metadata          Json?
  createdAt         DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════
// FACTURAS (FASE 03)
// ═══════════════════════════════════════════

model Invoice {
  id                      String    @id @default(uuid())
  subscriptionId          String?
  organizationId          String
  stripeInvoiceId         String?   @unique
  stripePaymentIntentId   String?
  number                  String?   // Número de factura oficial
  status                  String    // draft, open, paid, void, uncollectible
  currency                String    @default("EUR")
  amountSubtotal          Int       // Subtotal en céntimos
  amountTax               Int       @default(0) // Impuestos en céntimos
  amountTotal             Int       // Total en céntimos
  amountPaid              Int       @default(0) // Cantidad pagada
  amountRemaining         Int       @default(0) // Cantidad pendiente
  periodStart             DateTime? // Inicio del periodo facturado
  periodEnd               DateTime? // Fin del periodo facturado
  invoicePdf              String?   // URL al PDF de Stripe
  hostedInvoiceUrl        String?   // URL pública de la factura
  paidAt                  DateTime?
  dueDate                 DateTime?
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([stripeInvoiceId])
  @@index([status])
}

// ═══════════════════════════════════════════
// TRABAJOS DE HERRAMIENTAS (FASE 03)
// ═══════════════════════════════════════════

enum ToolJobStatus {
  QUOTED      // Cotización generada
  AUTHORIZED  // Usuario autorizó ejecución
  RESERVED    // Créditos reservados
  RUNNING     // En ejecución
  SUCCEEDED   // Completado exitosamente
  FAILED      // Falló
  CANCELLED   // Cancelado por usuario
  SETTLED     // Consumo liquidado
  REFUNDED    // Reembolsado
}

model ToolUsageJob {
  id                String          @id @default(uuid())
  organizationId    String
  toolId            String
  toolVersionId     String?
  userId            String          // Usuario que inició el trabajo
  status            ToolJobStatus   @default(QUOTED)
  quotedCredits     Int             // Créditos cotizados
  reservedCredits   Int             // Créditos reservados
  consumedCredits   Int             @default(0) // Créditos consumidos realmente
  refundedCredits   Int             @default(0) // Créditos reembolsados
  idempotencyKey    String?         @unique // Clave de idempotencia
  inputs            Json?           // Entradas del trabajo
  outputs           Json?           // Salidas del trabajo
  error             String?         // Error si falló
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  settledAt         DateTime?
  refundedAt        DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([toolId])
  @@index([status])
  @@index([idempotencyKey])
}

// ═══════════════════════════════════════════
// POLÍTICAS DE PRECIOS (FASE 03)
// ═══════════════════════════════════════════

model ToolPricePolicy {
  id              String   @id @default(uuid())
  toolId          String
  version         Int      @default(1)
  pricingModel    String   // FIXED, PER_UNIT, TIERED, TIME_BASED
  baseCredits     Int      // Créditos base
  additionalRules Json?    // Reglas adicionales de pricing
  minCredits      Int?     // Mínimo a cobrar
  maxCredits      Int?     // Máximo a cobrar
  refundPolicy    String   @default("FULL_ON_FAILURE") // FULL_ON_FAILURE, PARTIAL, NONE
  isActive        Boolean  @default(true)
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  createdAt       DateTime @default(now())

  @@unique([toolId, version])
  @@index([toolId])
  @@index([isActive])
}

// ═══════════════════════════════════════════
// EVENTOS DE STRIPE (FASE 03)
// ═══════════════════════════════════════════

model StripeWebhookEvent {
  id                  String    @id @default(uuid())
  stripeEventId       String    @unique // ID del evento en Stripe
  eventType           String    // Tipo de evento: checkout.session.completed, etc.
  apiVersion          String?   // Versión de API de Stripe
  objectId            String?   // ID del objeto principal (subscription, invoice, etc.)
  objectType          String?   // Tipo de objeto
  receivedAt          DateTime  @default(now())
  processedAt         DateTime?
  processingStatus    String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts            Int       @default(0)
  lastError           String?
  lastAttemptAt       DateTime?
  payload             Json      // Payload completo del evento
  idempotencyKey      String?   @unique // Clave de idempotencia para evitar duplicados
  
  @@index([stripeEventId])
  @@index([eventType])
  @@index([processingStatus])
  @@index([idempotencyKey])
  @@index([receivedAt])
}

// ═══════════════════════════════════════════
// AUDITORÍA COMERCIAL (FASE 03)
// ═══════════════════════════════════════════

model BillingAuditEvent {
  id              String   @id @default(uuid())
  organizationId  String?
  userId          String?
  action          String   // "subscription.created", "credits.granted", "invoice.paid", etc.
  resourceType    String?  // "subscription", "invoice", "wallet", etc.
  resourceId      String?
  amount          Int?     // Cantidad involucrada (céntimos o créditos)
  currency        String?  // "EUR" o "CREDITS"
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// AUDITORÍA
// ═══════════════════════════════════════════

model AuditEvent {
  id             String   @id @default(uuid())
  userId         String?
  organizationId String?
  action         String   // "user.login", "tool.run", "plan.upgrade", etc.
  resource       String?  // Tipo de recurso afectado
  resourceId     String?  // ID del recurso
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════════════════════════════════════
// SEGURIDAD
// ═══════════════════════════════════════════

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  ip        String
  success   Boolean
  reason    String?  // "invalid_password", "account_suspended", etc.
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([ip])
  @@index([createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String?
  action    String   // "login_failed", "session_revoked", "password_changed", etc.
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
}
