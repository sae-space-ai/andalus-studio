# ═══════════════════════════════════════════
# VARIABLES DE ENTORNO — Andalus Studio
# ═══════════════════════════════════════════
# COPIAR A .env Y RELLENAR. NUNCA COMMIT .env.

# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/andalus_studio"

# Redis (jobs)
REDIS_URL="redis://localhost:6379"

# Sesiones
SESSION_SECRET="cambiar-esto-por-valor-seguro-aleatorio"

# Stripe (TEST)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_CREATOR="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_STUDIO="price_..."

# Storage (S3-compatible)
S3_BUCKET="andalus-studio-assets"
S3_REGION="eu-west-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# App
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Email (transaccional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@andalus.ai"

# ⚠️ NUNCA poner claves reales en este archivo.
# ⚠️ NUNCA commit .env al repositorio.
