# =====================================================================
# ANDALUS CREATIVE WORLD — Variables de entorno (FASE 00)
# COPIAR A .env Y RELLENAR. NUNCA COMMIT .env. NUNCA CLAVES REALES AQUÍ.
# =====================================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://acw:acw@localhost:5432/andalus_creative_world"

# --- Sesiones / seguridad ---
SESSION_SECRET="cambiar-por-valor-aleatorio-seguro-minimo-32-bytes"
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3001"

# --- Google OIDC (NO RELLENAR con credenciales inventadas) ---
# Sin estas variables, el login con Google queda DESHABILITADO y no se muestra como operativo.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# --- Email transaccional ---
# Desarrollo: Mailpit (SMTP localhost:1025). Producción: proveedor real pendiente de aprobación.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@andaluscreative.world"

# --- Stripe (SOLO TEST; nunca LIVE sin aprobación del propietario) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Redis / Jobs (solo cuando existan jobs reales que lo requieran) ---
REDIS_URL=""

# --- Storage privado de documentos subidos ---
STORAGE_DIR="./storage-dev"
MAX_UPLOAD_MB=25
