{
  "name": "andalus-creative-world",
  "private": true,
  "version": "0.0.0",
  "description": "ANDALUS CREATIVE WORLD — Cine · Creación · Comunidad · Festivales (Marca matriz: AL-ANDALUS AI)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @acw/web",
    "dev:api": "npm run dev --workspace @acw/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.7.0"
  }
}
