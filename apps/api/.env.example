# ═══════════════════════════════════════════
# VARIABLES DE ENTORNO - ANDALUS STUDIO API
# FASE 02 - Backend Real
# ═══════════════════════════════════════════
# COPIAR A .env Y RELLENAR. NUNCA COMMIT .env.

# ═══════════════════════════════════════════
# SERVIDOR
# ═══════════════════════════════════════════

NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# ═══════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════

FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════
# BASE DE DATOS
# ═══════════════════════════════════════════

DATABASE_URL=postgresql://user:password@localhost:5432/andalus_studio

# ═══════════════════════════════════════════
# SESIONES
# ═══════════════════════════════════════════

# Generar con: openssl rand -hex 32
SESSION_SECRET=cambiar-esto-por-valor-seguro-aleatorio-minimo-32-caracteres
SESSION_MAX_AGE_DAYS=7

# ═══════════════════════════════════════════
# COOKIES
# ═══════════════════════════════════════════

# true en producción con HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ═══════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════

# Opciones: smtp, console, none
EMAIL_PROVIDER=console

# Solo si EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=contraseña

EMAIL_FROM=noreply@andalus.ai

# ═══════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ═══════════════════════════════════════════
# TOKENS
# ═══════════════════════════════════════════

EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# ═══════════════════════════════════════════
# STRIPE (FASE 03)
# ═══════════════════════════════════════════

# Modo: TEST o LIVE (NUNCA usar LIVE en desarrollo)
STRIPE_MODE=TEST

# Claves de Stripe (obtener de https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de precios en Stripe (crear en https://dashboard.stripe.com/test/products)
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_CREATOR_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_YEARLY=price_...

# Configuración del portal de Stripe (opcional)
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# URLs
API_URL=http://localhost:3001
STRIPE_WEBHOOK_URL=http://localhost:3001/api/webhooks/stripe

# ═══════════════════════════════════════════
# NOTAS
# ═══════════════════════════════════════════

# ⚠️ NUNCA poner claves reales en este archivo.
# ⚠️ NUNCA commit .env al repositorio.
# ⚠️ En producción, usar variables de entorno del sistema.
# ⚠️ NUNCA usar claves LIVE en desarrollo.
